# ==============================================================================
# CrowdWisdomTrading X Sentiment Price Prediction Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env and insert your API keys:
#   cp .env.example .env

# ------------------------------------------------------------------------------
# Apify Configuration (for X / Twitter Scraping)
# ------------------------------------------------------------------------------
# APIFY_TOKEN: Your personal Apify API token from https://console.apify.com/account/integrations
APIFY_TOKEN=your_apify_api_token_here

# APIFY_ACTOR_ID: The Apify actor ID or username/actor-name to use for X/Twitter data collection
# Examples:
#   - apidojo/tweet-scraper
#   - quacker/twitter-scraper
#   - kaitoeasyapi/twitter-x-data-tweet-scraper
APIFY_ACTOR_ID=apidojo/tweet-scraper

# ------------------------------------------------------------------------------
# News APIs Configuration (for Current Sentiment Outlook)
# ------------------------------------------------------------------------------
# TAVILY_API_KEY: Tavily Search API key from https://app.tavily.com/
TAVILY_API_KEY=your_tavily_api_key_here

# EXA_API_KEY: (Optional) Exa AI search key from https://dashboard.exa.ai/
EXA_API_KEY=your_exa_api_key_here

# ------------------------------------------------------------------------------
# Pipeline & Asset Configuration Defaults
# ------------------------------------------------------------------------------
ASSET_TICKER=BTC-USD
HISTORY_DAYS=180
INTERVAL=1d
DATABASE_PATH=data/crowdwisdom.db
USE_SAMPLE_DATA_FALLBACK=True
LOG_LEVEL=INFO
